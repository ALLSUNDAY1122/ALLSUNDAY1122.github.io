{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/moises/lane3/L3-M04_REFERENCE_FIXTURE.schema.json",
  "title": "Lane 3 offline reference fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureID", "stems", "projectStartSeconds", "projectEndSeconds", "outputSampleRate",
    "practice", "beatTimesSeconds"
  ],
  "properties": {
    "fixtureID": {"type": "string", "minLength": 1},
    "stems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startSeconds", "frameCount", "sampleRate", "gain"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "startSeconds": {"type": "number", "minimum": 0},
          "frameCount": {"type": "integer", "minimum": 1},
          "sampleRate": {"type": "number", "exclusiveMinimum": 0},
          "gain": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "projectStartSeconds": {"type": "number", "minimum": 0},
    "projectEndSeconds": {"type": "number", "exclusiveMinimum": 0},
    "outputSampleRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 768000},
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tempoRatio", "pitchSemitones", "metronomeEnabled", "downbeatStride"],
      "properties": {
        "tempoRatio": {"type": "number", "minimum": 0.03125, "maximum": 32},
        "pitchSemitones": {"type": "number", "minimum": -24, "maximum": 24},
        "metronomeEnabled": {"type": "boolean"},
        "countInClicks": {"type": ["integer", "null"], "minimum": 1, "maximum": 32},
        "downbeatStride": {"type": "integer", "minimum": 1}
      }
    },
    "beatTimesSeconds": {
      "type": "array",
      "items": {"type": "number"}
    },
    "countInBeatIntervalSeconds": {"type": ["number", "null"], "exclusiveMinimum": 0}
  }
}
