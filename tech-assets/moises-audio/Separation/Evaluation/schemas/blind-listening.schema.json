{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project.local/moises/separation/blind-listening.schema.json",
  "title": "Blind listening raw score records",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["run_id", "fixture_id", "system_blind_id", "revealed_system", "stem", "scores", "notes", "listener_id", "timestamp"],
    "properties": {
      "run_id": {"type": "string", "minLength": 1},
      "fixture_id": {"type": "string", "minLength": 1},
      "system_blind_id": {"enum": ["A", "B"]},
      "revealed_system": {"enum": ["PROJECT", "REFERENCE"]},
      "stem": {"type": "string", "minLength": 1},
      "scores": {
        "type": "object",
        "required": ["target_preservation", "bleed", "musical_noise", "transient_integrity", "timbre_formant_integrity", "stereo_phase_integrity", "low_frequency_integrity", "reverb_ambience", "overall_practice_usability"],
        "additionalProperties": false,
        "properties": {
          "target_preservation": {"type": "integer", "minimum": 0, "maximum": 4},
          "bleed": {"type": "integer", "minimum": 0, "maximum": 4},
          "musical_noise": {"type": "integer", "minimum": 0, "maximum": 4},
          "transient_integrity": {"type": "integer", "minimum": 0, "maximum": 4},
          "timbre_formant_integrity": {"type": "integer", "minimum": 0, "maximum": 4},
          "stereo_phase_integrity": {"type": "integer", "minimum": 0, "maximum": 4},
          "low_frequency_integrity": {"type": "integer", "minimum": 0, "maximum": 4},
          "reverb_ambience": {"type": "integer", "minimum": 0, "maximum": 4},
          "overall_practice_usability": {"type": "integer", "minimum": 0, "maximum": 4}
        }
      },
      "notes": {"type": "array", "items": {"type": "string"}},
      "listener_id": {"type": "string", "minLength": 1},
      "timestamp": {"type": "string", "minLength": 1}
    }
  }
}
