{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/moises/rights-cleared-audio-index.schema.json",
  "title": "Lane 1 E02 private rights index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_state", "corpus_id", "corpus_revision", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_state": {"const": "NON_PARITY_EVIDENCE_ONLY"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_revision": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "expected_group", "fixture_manifest_path", "fixture_manifest_sha256", "grant_record_path", "grant_record_sha256"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "expected_group": {"enum": ["G1", "G2"]},
          "fixture_manifest_path": {"type": "string", "minLength": 1},
          "fixture_manifest_sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"},
          "grant_record_path": {"type": "string", "minLength": 1},
          "grant_record_sha256": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$"}
        }
      }
    }
  }
}
