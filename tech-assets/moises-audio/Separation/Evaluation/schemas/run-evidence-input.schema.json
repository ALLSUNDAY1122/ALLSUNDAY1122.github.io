{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project.local/moises/separation/run-evidence-input.schema.json",
  "title": "Separation run evidence input",
  "type": "object",
  "required": ["schema_version", "run_id", "fixture_id", "provider", "timing_ms", "cost", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "required": ["provider_id", "provider_kind", "model_name", "model_version", "execution_topology", "commercial_approval_basis_id"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "provider_kind": {"type": "string", "minLength": 1},
        "model_name": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "model_hash": {"type": ["string", "null"]},
        "execution_topology": {"type": "string", "minLength": 1},
        "commercial_approval_basis_id": {"type": "string", "minLength": 1}
      }
    },
    "timing_ms": {
      "type": "object",
      "required": ["upload", "queue", "inference", "download", "total"],
      "additionalProperties": false,
      "properties": {
        "upload": {"type": "number", "minimum": 0},
        "queue": {"type": "number", "minimum": 0},
        "inference": {"type": "number", "minimum": 0},
        "download": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      }
    },
    "cost": {
      "type": "object",
      "required": ["currency", "total", "basis"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "total": {"type": "number", "minimum": 0},
        "credits": {"type": ["number", "null"], "minimum": 0},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "container", "sample_rate_hz", "channels", "frame_count", "duration_seconds"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "artifact_path": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"]},
          "container": {"type": "string", "minLength": 1},
          "sample_rate_hz": {"type": "integer", "minimum": 8000},
          "channels": {"type": "integer", "minimum": 1},
          "frame_count": {"type": "integer", "minimum": 1},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "source_url": {"type": ["string", "null"]},
          "source_url_expires_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
