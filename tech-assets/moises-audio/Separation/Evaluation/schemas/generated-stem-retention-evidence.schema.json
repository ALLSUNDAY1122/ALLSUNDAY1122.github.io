{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-stem-retention-evidence.schema.json",
  "title": "L1-A24 Generated Stem Retention Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "evidence_state", "deletion_id", "project_ref_hash", "role", "generation_ref_hash", "variant_index", "artifact_sha256", "delete_intent_evidence_sha256", "local_state", "active_pointer_removed", "manifest_removed", "object_removed", "object_retained_due_to_reference", "refund_state", "runtime_delete_state", "local_deletion_complete", "runtime_erasure_authoritatively_complete", "overall_erasure_complete", "refund_confirmed", "deletion_does_not_imply_refund", "path_emitted", "raw_audio_emitted", "raw_runtime_id_emitted", "raw_credit_or_billing_record_emitted", "parity_claim"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"const": "L1-A24-v1"},
    "evidence_state": {"const": "NON_PARITY_EVIDENCE_ONLY"},
    "deletion_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "project_ref_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "generation_ref_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variant_index": {"type": "integer", "minimum": 0},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delete_intent_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_state": {"enum": ["DELETE_INTENT_DURABLE", "ACTIVE_DETACHED", "MANIFEST_REMOVED", "LOCAL_DELETED"]},
    "active_pointer_removed": {"type": "boolean"},
    "manifest_removed": {"type": "boolean"},
    "object_removed": {"type": "boolean"},
    "object_retained_due_to_reference": {"type": "boolean"},
    "refund_state": {"enum": ["NOT_APPLICABLE", "NOT_REQUESTED", "PENDING", "CONFIRMED", "DENIED", "UNKNOWN"]},
    "runtime_delete_state": {"enum": ["NOT_APPLICABLE", "NOT_REQUESTED", "PENDING", "CONFIRMED", "NOT_FOUND", "UNSUPPORTED", "UNKNOWN"]},
    "local_deletion_complete": {"type": "boolean"},
    "runtime_erasure_authoritatively_complete": {"type": "boolean"},
    "overall_erasure_complete": {"type": "boolean"},
    "refund_confirmed": {"type": "boolean"},
    "deletion_does_not_imply_refund": {"const": true},
    "path_emitted": {"const": false},
    "raw_audio_emitted": {"const": false},
    "raw_runtime_id_emitted": {"const": false},
    "raw_credit_or_billing_record_emitted": {"const": false},
    "parity_claim": {"const": "NONE"}
  }
}
