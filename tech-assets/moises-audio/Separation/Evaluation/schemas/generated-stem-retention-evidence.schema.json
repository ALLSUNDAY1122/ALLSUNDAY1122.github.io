{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-stem-retention-evidence.schema.json",
  "title": "L1-A24 Generated Stem Retention Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "evidence_state", "retention_policy_sha256", "project_ref_hash", "role", "generation_ref_hash", "variant_index", "artifact_sha256", "mix_ready_receipt_sha256", "delete_requested", "delete_reason", "association_delete_confirmed", "physical_artifact_state", "runtime_delete_state", "runtime_erasure_confirmed", "refund_state", "refund_evidence_sha256", "runtime_erasure_evidence_sha256", "privacy_erasure_complete", "raw_logical_generation_id_emitted", "raw_execution_id_emitted", "path_emitted", "raw_audio_emitted", "parity_claim"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"const": "L1-A24-v1"},
    "evidence_state": {"const": "NON_PARITY_EVIDENCE_ONLY"},
    "retention_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_ref_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "generation_ref_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variant_index": {"type": "integer", "minimum": 0},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mix_ready_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delete_requested": {"type": "boolean"},
    "delete_reason": {"oneOf": [{"type": "null"}, {"enum": ["USER_DELETE", "PROJECT_DELETE", "CANCEL_CLEANUP", "SUPERSEDED_RETENTION", "ORPHAN_ABANDONED"]}]},
    "association_delete_confirmed": {"type": "boolean"},
    "physical_artifact_state": {"enum": ["not_attempted", "confirmed_erased", "retained_shared_reference", "missing_before_delete", "unknown_after_error"]},
    "runtime_delete_state": {"enum": ["not_requested", "not_applicable", "unsupported", "identifier_unavailable", "accepted", "confirmed", "not_found", "unknown_after_error", "unknown_invalid_receipt"]},
    "runtime_erasure_confirmed": {"type": "boolean"},
    "refund_state": {"enum": ["not_checked", "released_no_charge", "reserved_unsettled", "not_eligible", "eligible_not_requested", "pending_authority", "confirmed", "state_unknown"]},
    "refund_evidence_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "runtime_erasure_evidence_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "privacy_erasure_complete": {"type": "boolean"},
    "raw_logical_generation_id_emitted": {"const": false},
    "raw_execution_id_emitted": {"const": false},
    "path_emitted": {"const": false},
    "raw_audio_emitted": {"const": false},
    "parity_claim": {"const": "NONE"}
  },
  "allOf": [
    {"if": {"properties": {"delete_requested": {"const": true}}}, "then": {"properties": {"delete_reason": {"enum": ["USER_DELETE", "PROJECT_DELETE", "CANCEL_CLEANUP", "SUPERSEDED_RETENTION", "ORPHAN_ABANDONED"]}}}},
    {"if": {"properties": {"runtime_erasure_confirmed": {"const": true}}}, "then": {"properties": {"runtime_delete_state": {"enum": ["confirmed", "not_found", "not_applicable"]}, "runtime_erasure_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    {"if": {"properties": {"refund_state": {"const": "confirmed"}}}, "then": {"properties": {"refund_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    {"if": {"properties": {"privacy_erasure_complete": {"const": true}}}, "then": {"properties": {"association_delete_confirmed": {"const": true}, "physical_artifact_state": {"enum": ["confirmed_erased", "missing_before_delete"]}, "runtime_erasure_confirmed": {"const": true}}}}
  ]
}
