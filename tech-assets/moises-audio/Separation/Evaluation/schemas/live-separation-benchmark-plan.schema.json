{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-separation-benchmark-plan.schema.json",
  "title": "Lane 1 E03 Live Separation Benchmark Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_state", "benchmark_id", "execution", "requirements", "modes", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_state": {"const": "NON_PARITY_EVIDENCE_ONLY"},
    "benchmark_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_command", "timeout_seconds", "max_attempts_per_run", "driver_guarantees_stable_idempotency"],
      "properties": {
        "provider_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "number", "minimum": 1},
        "max_attempts_per_run": {"type": "integer", "minimum": 1},
        "driver_guarantees_stable_idempotency": {"const": true}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_successful_runs_per_mode", "minimum_g1_objective_runs",
        "max_final_failure_fraction", "max_retry_fraction", "require_two_stem",
        "require_core_four_stem", "require_custom_instrument", "hifi_required_by_reference"
      ],
      "properties": {
        "minimum_successful_runs_per_mode": {"type": "integer", "minimum": 2},
        "minimum_g1_objective_runs": {"type": "integer", "minimum": 1},
        "max_final_failure_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "max_retry_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "require_two_stem": {"type": "boolean"},
        "require_core_four_stem": {"type": "boolean"},
        "require_custom_instrument": {"type": "boolean"},
        "hifi_required_by_reference": {"type": "boolean"}
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode_id", "mode_class", "model_name", "model_version", "quality_profile", "target_roles", "required"],
        "properties": {
          "mode_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "mode_class": {"enum": ["TWO_STEM", "CORE_FOUR_STEM", "CUSTOM_INSTRUMENT", "HIFI_ADVANCED"]},
          "model_name": {"type": "string", "minLength": 1},
          "model_version": {"type": "string", "minLength": 1},
          "quality_profile": {"type": "string", "minLength": 1},
          "target_roles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required": {"type": "boolean"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "fixture_manifest", "mode_id", "repeat_count", "run_manifest_template"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "fixture_manifest": {"type": "string", "minLength": 1},
          "mode_id": {"type": "string", "minLength": 1},
          "repeat_count": {"type": "integer", "minimum": 1},
          "run_manifest_template": {"type": "string", "minLength": 1, "pattern": "\\{repeat\\}"}
        }
      }
    }
  }
}
