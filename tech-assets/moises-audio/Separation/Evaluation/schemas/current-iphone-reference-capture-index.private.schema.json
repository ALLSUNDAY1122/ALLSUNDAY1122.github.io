{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-iphone-reference-capture-index.private.schema.json",
  "title": "Lane 1 E04 Private Current-iPhone Reference Capture Index",
  "type": "object",
  "required": ["schema_version", "captures"],
  "properties": {
    "schema_version": {"const": 1},
    "captures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capture_id", "reference_system", "fixture_id", "input_mixture_sha256", "app_version", "app_build", "ios_version", "device_model", "account_tier", "reference_mode_label", "captured_at", "capture_provenance_path", "capture_provenance_sha256", "artifacts"],
        "properties": {
          "capture_id": {"type": "string", "minLength": 1},
          "reference_system": {"const": "MOISES_CURRENT_IPHONE"},
          "fixture_id": {"type": "string", "minLength": 1},
          "input_mixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "app_version": {"type": "string", "minLength": 1},
          "app_build": {"type": "string", "minLength": 1},
          "ios_version": {"type": "string", "minLength": 1},
          "device_model": {"type": "string", "minLength": 1},
          "account_tier": {"type": "string", "minLength": 1},
          "reference_mode_label": {"type": "string", "minLength": 1},
          "captured_at": {"type": "string", "format": "date-time"},
          "capture_provenance_path": {"type": "string", "minLength": 1},
          "capture_provenance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifacts": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["role", "path", "sha256"],
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
