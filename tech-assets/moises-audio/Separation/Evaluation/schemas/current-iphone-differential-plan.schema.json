{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-iphone-differential-plan.schema.json",
  "title": "Lane 1 E04 Current-iPhone Differential Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_state", "comparison_id", "policy", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_state": {"const": "NON_PARITY_EVIDENCE_ONLY"},
    "comparison_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_reviewers_per_case_role", "material_inferiority_vote_fraction", "min_mean_overall_usability_delta"],
      "properties": {
        "minimum_reviewers_per_case_role": {"type": "integer", "minimum": 2},
        "material_inferiority_vote_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "min_mean_overall_usability_delta": {"type": "number", "minimum": -4, "maximum": 4}
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "fixture_id", "project_logical_run_id", "reference_capture_id"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "fixture_id": {"type": "string", "minLength": 1},
          "project_logical_run_id": {"type": "string", "minLength": 1},
          "reference_capture_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
