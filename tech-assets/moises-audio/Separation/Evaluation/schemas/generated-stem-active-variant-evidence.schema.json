{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-stem-active-variant-evidence.schema.json",
  "title": "L1-A23 Generated Stem Active Variant Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "evidence_state", "project_ref_hash", "role", "generation_ref_hash", "variant_index", "artifact_sha256", "artifact_bytes", "sample_rate", "channels", "audio_format", "bits_per_sample", "frame_count", "mix_ready_receipt_sha256", "path_emitted", "raw_audio_emitted", "parity_claim"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"const": "L1-A23-v1"},
    "evidence_state": {"const": "NON_PARITY_EVIDENCE_ONLY"},
    "project_ref_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "generation_ref_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variant_index": {"type": "integer", "minimum": 0},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_bytes": {"type": "integer", "minimum": 1},
    "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 384000},
    "channels": {"type": "integer", "minimum": 1, "maximum": 64},
    "audio_format": {"enum": [1, 3]},
    "bits_per_sample": {"enum": [8, 16, 24, 32, 64]},
    "frame_count": {"type": "integer", "minimum": 1},
    "mix_ready_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path_emitted": {"const": false},
    "raw_audio_emitted": {"const": false},
    "parity_claim": {"const": "NONE"}
  }
}
