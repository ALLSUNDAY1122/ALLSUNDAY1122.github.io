{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://project.local/moises/separation/differential-resume-ledger.schema.json",
  "title":"L1-A20 durable differential resume ledger",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","tool_version","evidence_state","batch_id","batch_identity_sha256","acceptance_policy_sha256","golden_corpus_lock_sha256","state","case_order","cases","global_artifacts","review","acceptance","evidence_chain_sha256"],
  "properties":{
    "schema_version":{"const":1},
    "tool_version":{"const":"L1-A20-v1"},
    "evidence_state":{"const":"NON_PARITY_EVIDENCE_ONLY"},
    "batch_id":{"type":"string","minLength":1},
    "batch_identity_sha256":{"$ref":"#/$defs/sha"},
    "acceptance_policy_sha256":{"$ref":"#/$defs/sha"},
    "golden_corpus_lock_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},
    "state":{"enum":["ACTIVE","WAITING_REFERENCE","WAITING_REVIEWER_ROSTER","WAITING_REVIEW","ACCEPTANCE_READY","COMPLETE"]},
    "case_order":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "cases":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/case"}},
    "global_artifacts":{"type":"object","additionalProperties":{"$ref":"#/$defs/artifact"}},
    "review":{"$ref":"#/$defs/review"},
    "acceptance":{"anyOf":[{"$ref":"#/$defs/artifact"},{"type":"null"}]},
    "evidence_chain_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["relative_path","sha256","byte_count"],"properties":{"relative_path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"},"byte_count":{"type":"integer","minimum":0}}},
    "attempt":{"type":"object","additionalProperties":false,"required":["attempt","status","exit_code","wall_time_ms","stable_error_code"],"properties":{"attempt":{"type":"integer","minimum":1},"status":{"enum":["STARTED","PASS","FAIL","TIMEOUT","INTERRUPTED","RECOVERED_OUTPUT"]},"exit_code":{"type":["integer","null"]},"wall_time_ms":{"type":["number","null"],"minimum":0},"stable_error_code":{"type":["string","null"]}}},
    "case":{"type":"object","additionalProperties":false,"required":["case_identity_sha256","fixture_manifest_sha256","idempotency_key_sha256","phase","project_source","attempts","artifacts"],"properties":{"case_identity_sha256":{"$ref":"#/$defs/sha"},"fixture_manifest_sha256":{"$ref":"#/$defs/sha"},"idempotency_key_sha256":{"$ref":"#/$defs/sha"},"phase":{"type":"string","minLength":1},"project_source":{"type":["string","null"]},"attempts":{"type":"array","items":{"$ref":"#/$defs/attempt"}},"artifacts":{"type":"object","additionalProperties":{"$ref":"#/$defs/artifact"}}}},
    "review":{"type":"object","additionalProperties":false,"required":["roster_sha256","assignments_sha256","replacements_sha256","scores_sha256","active_assignment_sha256","missing_assignment_ids"],"properties":{"roster_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"assignments_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"replacements_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"scores_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"active_assignment_sha256":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"missing_assignment_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}}
  }
}
