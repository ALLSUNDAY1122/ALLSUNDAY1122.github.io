{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_state","batch_id","acceptance_policy_id","result","parity_state","parity_reason","metrics","checks"],
  "properties": {
    "schema_version":{"const":1},
    "evidence_state":{"const":"NON_PARITY_EVIDENCE_ONLY"},
    "batch_id":{"type":"string","minLength":1},
    "acceptance_policy_id":{"type":"string","minLength":1},
    "result":{"enum":["LANE_GATE_CANDIDATE_PASS","LANE_GATE_CANDIDATE_FAIL"]},
    "parity_state":{"const":"NON_PARITY_EVIDENCE_ONLY"},
    "parity_reason":{"type":"string","minLength":1},
    "metrics":{"type":"object"},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","required":["name","passed","actual","threshold"],"properties":{"name":{"type":"string"},"passed":{"type":"boolean"}},"additionalProperties":true}}
  }
}
