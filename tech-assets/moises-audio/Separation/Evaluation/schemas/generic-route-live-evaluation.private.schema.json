{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"generic-route-live-evaluation.private.schema.json",
  "title":"Lane 1 E09 Private Generic Route Live Evaluation",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evidence_kind","evidence_state","parity_claim","evaluation_state","route_id","route_kind","runtime","source_evidence","operational","benchmark","differential","provenance","privacy"],
  "properties":{
    "schema_version":{"const":1},"evidence_kind":{"const":"GENERIC_ROUTE_LIVE_EVALUATION"},"evidence_state":{"const":"NON_PARITY_EVIDENCE_ONLY"},"parity_claim":{"const":"NONE"},
    "evaluation_state":{"enum":["READY_FOR_HQ_E09_ROUTE_EVALUATION","WAITING_REVIEW","LIVE_EVALUATION_FAILED"]},
    "route_id":{"type":"string","minLength":1},
    "route_kind":{"enum":["LICENSED_LOCAL_INFERENCE_SDK","ALTERNATE_WRITTEN_COMMERCIAL_PROVIDER","PROJECT_OWNED_MODEL_IF_RIGHTS_CLEARED_TRAINING_DATA_AVAILABLE"]},
    "runtime":{"type":"object","additionalProperties":false,"required":["runtime_id","model_name","model_version","quality_profile","artifact_sha256"],"properties":{"runtime_id":{"type":"string"},"model_name":{"type":"string"},"model_version":{"type":"string"},"quality_profile":{"type":"string"},"artifact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "source_evidence":{"type":"object","additionalProperties":false,"required":["e07_evidence_sha256","e07_substitution_lock_sha256","e08_evidence_sha256","e08_live_authority_lock_sha256"],"properties":{"e07_evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"e07_substitution_lock_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"e08_evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"e08_live_authority_lock_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "operational":{"type":"object","additionalProperties":false,"required":["commercial_use_allowed","input_confidential","output_commercial_use_allowed","output_export_allowed","training_on_user_content_allowed","service_region","data_region","uploaded_asset_retention_seconds","deletion_control_available","commercial_basis_sha256"],"properties":{"commercial_use_allowed":{"type":"boolean"},"input_confidential":{"type":"boolean"},"output_commercial_use_allowed":{"type":"boolean"},"output_export_allowed":{"type":"boolean"},"training_on_user_content_allowed":{"type":"boolean"},"service_region":{"type":"string"},"data_region":{"type":"string"},"uploaded_asset_retention_seconds":{"type":"number","minimum":0},"deletion_control_available":{"type":"boolean"},"commercial_basis_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "benchmark":{"type":"object","additionalProperties":false,"required":["mode_classes","g1_objective_run_count","g1_objective_floor_pass","final_failure_fraction","retry_fraction","mean_execution_total_ms","mean_cost_per_successful_run","cost_currency","successful_run_count"],"properties":{"mode_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"g1_objective_run_count":{"type":"integer","minimum":0},"g1_objective_floor_pass":{"type":"boolean"},"final_failure_fraction":{"type":"number","minimum":0,"maximum":1},"retry_fraction":{"type":"number","minimum":0,"maximum":1},"mean_execution_total_ms":{"type":"number","minimum":0},"mean_cost_per_successful_run":{"type":"number","minimum":0},"cost_currency":{"type":"string","minLength":3,"maxLength":3},"successful_run_count":{"type":"integer","minimum":0}}},
    "differential":{"type":"object","additionalProperties":false,"required":["exact_input_bytes","overall_usability_delta_project_minus_reference","material_inferiority_detected","overall_usability_threshold_pass","material_inferiority_vote_pass"],"properties":{"exact_input_bytes":{"type":"boolean"},"overall_usability_delta_project_minus_reference":{"type":["number","null"],"minimum":-4,"maximum":4},"material_inferiority_detected":{"type":"boolean"},"overall_usability_threshold_pass":{"type":"boolean"},"material_inferiority_vote_pass":{"type":"boolean"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["operational","benchmark","differential"],"properties":{"operational":{"$ref":"#/$defs/provenance"},"benchmark":{"$ref":"#/$defs/provenance"},"differential":{"$ref":"#/$defs/provenance"}}},
    "privacy":{"type":"object"}
  },
  "$defs":{"provenance":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
}
