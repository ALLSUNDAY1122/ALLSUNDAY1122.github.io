{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/moises/commercial-route-evidence.schema.json",
  "title": "L1-E01 sanitized commercial route evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","evidence_kind","evidence_state","result","parity_claim","provider","credential_preflight","terms","operational_policy","approval_manifest_identity_sha256","generated_at"],
  "properties": {
    "schema_version":{"const":1},
    "evidence_kind":{"const":"COMMERCIAL_ROUTE_APPROVAL"},
    "evidence_state":{"const":"NON_PARITY_EVIDENCE_ONLY"},
    "result":{"enum":["READY_FOR_LIVE_PROVIDER_GATE","PENDING_EXTERNAL_CREDENTIAL"]},
    "parity_claim":{"const":"NONE"},
    "provider":{"type":"object"},
    "credential_preflight":{"type":"object","required":["environment_names","all_present","values_persisted","server_side_only","client_distribution_prohibited","repository_exact_secret_scan"],"properties":{"environment_names":{"type":"array","items":{"type":"string"}},"all_present":{"type":"boolean"},"values_persisted":{"const":false},"server_side_only":{"const":true},"client_distribution_prohibited":{"const":true},"repository_exact_secret_scan":{"enum":["NOT_RUN","PENDING_CREDENTIAL","PASS"]}}},
    "terms":{"type":"object"},
    "operational_policy":{"type":"object","required":["pricing_values_persisted","pricing_config_sha256","operational_policy_sha256"],"properties":{"pricing_values_persisted":{"const":false},"pricing_config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"operational_policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "approval_manifest_identity_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "generated_at":{"type":"string","minLength":1}
  }
}
