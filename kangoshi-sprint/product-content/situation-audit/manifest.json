{
  "schemaVersion": 3,
  "scope": {
    "qualification": "看護師国家試験",
    "sourceExams": [115, 114, 113],
    "category": "状況設定",
    "questionCount": 180,
    "scenarioCount": 60,
    "questionsPerScenario": 3
  },
  "stateModel": {
    "progressSourceOfTruth": "kangoshi-sprint/product-content/situation-audit/report.json",
    "canonicalGateSourceOfTruth": "kangoshi-sprint/product-content/questions/situation-canonical-gate.json",
    "canonicalIntegritySourceOfTruth": "kangoshi-sprint/product-content/questions/situation-canonical-integrity-audit.json",
    "expertQueueSourceOfTruth": "kangoshi-sprint/product-content/situation-audit/expert-review-queue.json",
    "mediaAuditSourceOfTruth": "kangoshi-sprint/product-content/situation-audit/media-audit.json",
    "progressDerivation": "artifact-driven",
    "manualCountersAuthoritative": false,
    "manualCursorAuthoritative": false,
    "expertReviewIsContentAuthoringBlocker": false,
    "affectedQuestionQuarantineOnly": true,
    "noProgressPolicy": "standard-procedure-v2.5 / NO_PROGRESS-v2.0"
  },
  "auditPolicy": {
    "unit": "scenario",
    "requiredScenarioTotal": 3,
    "requiredScenarioIndexes": [0, 1, 2],
    "requireSameScenarioTextAcrossTriplet": true,
    "requireThreeQuestionLinkage": true,
    "requireScenarioContextForClassification": true,
    "requireScenarioContextForExplanation": true,
    "requirePatientIdentityFromScenario": true,
    "requireClinicalConsistencyAcrossTriplet": true,
    "requireExplanationEvidenceForAllThree": true,
    "requireEvidenceCheckedDateForAllThree": true,
    "rawDataIsNotTrustedWithoutScenarioAudit": true,
    "scenarioAuditMayRecombineSplitBatchStorage": true,
    "canonicalRebuildAndReauditRequired": true
  },
  "protectedAreas": [
    "必修問題",
    "一般問題",
    "共通UI",
    "模試エンジン",
    "StoreKit"
  ],
  "completionModel": {
    "contentAuthoringPass": "derive only from situation-audit/report.json",
    "canonicalPass": "derive only from questions/situation-canonical-gate.json and situation-canonical-integrity-audit.json",
    "releasePass": "canonicalPass plus no unresolved affected-question quarantine",
    "deprecatedHardGates": [
      "expertReviewedScenarios == 60",
      "finalPassScenarios manually incremented in chat",
      "manual cursor completion",
      "artifactSnapshot counters in this manifest"
    ]
  },
  "automation": {
    "authoringAuditValidator": "kangoshi-sprint/product-content/situation-audit/validate_situation_audit.py",
    "authoringAuditWorkflow": ".github/workflows/kangoshi-situation-audit.yml",
    "canonicalBuilder": "kangoshi-sprint/product-content/build_situation_canonical.py",
    "canonicalValidator": "kangoshi-sprint/product-content/validate_situation_canonical.py",
    "canonicalWorkflow": ".github/workflows/kangoshi-situation-canonical.yml"
  },
  "knownHistoricalFailureModes": [
    "next scenario stem leaking into previous question choices during PDF extraction",
    "family member wording such as 男児 being misread as the patient identity during classification"
  ],
  "recoveryRecord": {
    "oldMethodFamily": "manual chat cursor + manually maintained progress counters",
    "failureEvidence": "manual snapshot became stale and blocked forward progress despite completed GitHub artifacts",
    "newMethodFamily": "artifact-driven inventory + deterministic canonical rebuild + affected-question quarantine",
    "manualProgressSnapshotRemoved": true
  },
  "status": "derive_runtime_status_from_authoritative_reports",
  "updatedAt": "2026-08-14"
}
