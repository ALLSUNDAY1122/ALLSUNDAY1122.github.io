{
  "manifest_version": 3,
  "name": "ChatGPT Queue Dispatcher (App Development 2)",
  "version": "0.2.0",
  "description": "GitHub Queueからアプリ別ChatGPT Workerへタスクを配車するDispatcher。回答本文は収集しません。",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*", "https://raw.githubusercontent.com/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content-script.js"],
    "run_at": "document_idle"
  }]
}
