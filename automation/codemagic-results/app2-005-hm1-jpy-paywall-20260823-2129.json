        "name": "Generate Xcode project",
        "type": "script",
        "has_test_results": false,
        "script": "#!/usr/bin/env bash\n\nset -o pipefail\n{\n  set -x\n  cd \"$CM_BUILD_DIR/ios/health-manager-1\"\n  python3 - <<'PY2'\nfrom pathlib import Path\nimport re\ns=Path('project.yml').read_text(encoding='utf-8')\nm=re.search(r'CURRENT_PROJECT_VERSION:\\s*(\\d+)',s)\nif not m:\n    raise SystemExit('CURRENT_PROJECT_VERSION missing')\nprint('PASS: CURRENT_PROJECT_VERSION='+m.group(1))\nPY2\n  xcodegen --version\n  xcodegen generate\n} 2>&1 | tee /tmp/hm1-xcodegen.log",
