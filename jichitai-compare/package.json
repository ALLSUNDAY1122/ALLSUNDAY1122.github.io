{
  "name": "jichitai-compare-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:scope": "node ./scripts/check-change-scope.mjs",
    "generate": "node ./scripts/generate-municipalities.mjs",
    "progress": "node ./scripts/update-progress.mjs && node ./scripts/update-index-count.mjs",
    "validate": "node ./scripts/validate-data.mjs",
    "validate:sessions": "node ./scripts/validate-session-split.mjs",
    "validate:generated": "node ./scripts/validate-data.mjs --require-generated",
    "smoke:public": "node ./scripts/smoke-public-site.mjs",
    "check": "npm run generate && npm run progress && npm run validate:generated && npm run validate:sessions"
  }
}
