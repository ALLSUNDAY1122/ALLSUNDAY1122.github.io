{
  "name": "jichitai-compare-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:scope": "node ./scripts/check-change-scope.mjs",
    "generate": "node ./scripts/generate-municipalities.mjs",
    "progress": "node ./scripts/update-progress.mjs",
    "validate:identity": "node ./scripts/validate-municipality-identity.mjs",
    "validate": "npm run validate:identity && node ./scripts/validate-data.mjs",
    "validate:generated": "npm run validate:identity && node ./scripts/validate-data.mjs --require-generated",
    "smoke:public": "node ./scripts/smoke-public-site.mjs",
    "check": "npm run generate && npm run progress && npm run validate:generated"
  }
}
