{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".tmp-regression",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/types/index.ts",
    "src/services/localQuestionGenerator.ts",
    "src/services/ocrAwareQuestionGenerator.ts"
  ]
}
